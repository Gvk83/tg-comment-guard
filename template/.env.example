# Токен бота от @BotFather. Настоящий токен хранится только в файле .env — его нет в репозитории.
BOT_TOKEN=123456:PUT_YOUR_TOKEN_HERE

# ID чата комментариев (группы обсуждений). Обычно отрицательное число вида -1001234567890.
# Можно указать несколько через запятую. Пусто = бот работает во всех группах, куда его добавили.
CHAT_IDS=

# Режим работы:
#   observe — только наблюдает и сообщает, ничего не удаляет и не банит (безопасный старт)
#   soft    — удаляет спам, но никого не банит
#   enforce — удаляет спам и банит отправителя при высокой уверенности
MODE=observe

# Уведомления администратору о срабатываниях
NOTIFY_ADMIN=true
# Ваш личный Telegram ID (число). Узнать: напишите боту @userinfobot
ADMIN_ID=

# Дополнительные ID, которых бот никогда не трогает (через запятую)
WHITELIST_IDS=

# Удалять служебные сообщения «X теперь в группе», «X покинул группу»,
# смену названия и фото чата. Работает в любом режиме, включая observe.
DELETE_SERVICE_MESSAGES=true

# Хранить текст СРАБОТАВШИХ сообщений в журнале, чтобы видеть их в /last
# и добавлять в образцы спама. Обычные сообщения не сохраняются никогда.
STORE_MESSAGE_TEXT=true

# Час ежедневной сводки «бот работает» по времени сервера (0-23).
# Пусто или «выкл» — сводку не присылать.
DAILY_REPORT_HOUR=10

# Сколько дней хранить записи журнала. 0 — хранить бессрочно.
LOG_RETENTION_DAYS=90

# Удалять видео-кружки, голосовые и истории от тех, кто ещё ни разу не писал
# в чате — через них тоже рассылают рекламу. Обычное общение это не затрагивает.
BLOCK_NEWCOMER_MEDIA=false

# Файл базы данных
DB_PATH=data/moderator.db

# Уровень логирования: INFO или DEBUG
LOG_LEVEL=INFO
